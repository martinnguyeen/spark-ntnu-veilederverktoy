{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spark.local/contracts/meeting.schema.json",
  "title": "Spark meeting (macOS and Windows)",
  "type": "object",
  "required": ["id", "title", "date", "duration", "state", "transcript"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "title": { "type": "string", "maxLength": 500 },
    "date": { "type": "string", "format": "date-time" },
    "duration": { "type": "number", "minimum": 0 },
    "state": { "enum": ["idle", "recording", "finalizing", "transcribing", "transcriptReady", "analyzing", "completed", "completedWithoutAnalysis"] },
    "transcript": { "type": "array", "items": { "$ref": "#/$defs/segment" } },
    "analysis": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/analysis" }] }
  },
  "$defs": {
    "segment": {
      "type": "object", "required": ["id", "start", "end", "text"],
      "properties": {
        "id": { "type": "string" }, "start": { "type": "number", "minimum": 0 }, "end": { "type": "number", "minimum": 0 },
        "speaker": { "type": ["string", "null"] }, "text": { "type": "string" }
      }
    },
    "evidenceIDs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "confidence": { "enum": ["low", "medium", "high"] },
    "evidence": {
      "type": "object", "required": ["text", "evidence_segment_ids"],
      "properties": { "text": { "type": "string" }, "confidence": { "$ref": "#/$defs/confidence" }, "evidence_segment_ids": { "$ref": "#/$defs/evidenceIDs" } }
    },
    "action": {
      "type": "object", "required": ["task", "confidence", "evidence_segment_ids"],
      "properties": {
        "task": { "type": "string" }, "owner": { "type": ["string", "null"] }, "deadline": { "type": ["string", "null"] }, "confidence": { "$ref": "#/$defs/confidence" }, "evidence_segment_ids": { "$ref": "#/$defs/evidenceIDs" }
      }
    },
    "analysis": {
      "type": "object", "required": ["schema_version", "summary", "key_points", "decisions", "action_items", "open_questions"],
      "properties": {
        "schema_version": { "const": "1.0" }, "summary": { "type": "string" },
        "key_points": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }, "decisions": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "action_items": { "type": "array", "items": { "$ref": "#/$defs/action" } }, "open_questions": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
      }
    }
  }
}
